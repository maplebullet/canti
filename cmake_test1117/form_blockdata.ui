          <property name="styleSheet">
           <string notr="true">QGroupBox
{
font-size: 20px;
font-family:黑体;
font-weight: normal;
color: #000000;
letter-spacing: 3px;
 border: 1px solid #a3a3a3; /* 1px 浅灰色实线边框 */
   margin-top: 10px; /* 给标题留出足够的顶部空间 */
  padding: 10px 10px 10px 10px; 


}
/* 单独设置标题样式，避免标题和边框重叠 */
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px; /* 标题距左侧距离 */
    top: 0px; /* 标题向上偏移，卡在边框上 */

    padding: 0 5px; /* 标题左右留白，避免文字贴边框 */
}
QLabel{
	font: 14pt &quot;Microsoft YaHei UI&quot;;
	color: rgb(0, 0, 0);
}
</string>
